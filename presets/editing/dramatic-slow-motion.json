{
  "schema_version": 1,
  "id": "dramatic-slow-motion",
  "name": "Dramatic Slow Motion",
  "version": 1,
  "description": "Slow-motion holds before drops, long shots, impact flash on the drop.",
  "pacing": {
    "base_shot_beats": 8.0,
    "section_multipliers": {
      "intro": 2.0,
      "groove": 1.5,
      "build_up": 1.0,
      "drop": 1.0,
      "breakdown": 2.0,
      "outro": 2.0
    },
    "min_shot_secs": 1.0,
    "max_shot_secs": 8.0,
    "build_up_acceleration": 0.2
  },
  "beat_sync": 0.7,
  "drop": {
    "impact": 0.9,
    "position": 0.5,
    "flash": true,
    "zoom_punch": 0.1,
    "rgb_split": false,
    "shake": false,
    "pre_drop_hold_beats": 2.0,
    "pre_drop_slowmo": 0.5,
    "velocity": 0,
    "glitch": 0,
    "zoom_blur": 0
  },
  "effects": {
    "intensity": 0.4,
    "kick_zoom": 0.03,
    "kick_shake": 0.0,
    "kick_threshold": 0.7,
    "cooldown_beats": 2.0,
    "max_per_bar": 1,
    "kick_sections": [
      "drop"
    ],
    "color": {
      "brightness": -0.02,
      "contrast": 1.1,
      "saturation": 0.9
    },
    "vignette": 0.3,
    "slow_zoom": 0.05,
    "kick_glitch": 0,
    "kick_blur": 0,
    "kick_chroma": 0
  },
  "transitions": {
    "frequency": 0.3,
    "kinds": [
      "cross_dissolve",
      "dip_to_black"
    ],
    "duration_beats": 1.0,
    "sections": [
      "intro",
      "breakdown",
      "outro"
    ]
  },
  "energy_bias": -0.1,
  "smart_crop": true,
  "fade_in_secs": 0.5,
  "fade_out_secs": 1.0,
  "output": {
    "platforms": [
      "tiktok",
      "reels",
      "shorts"
    ],
    "aspect": "9:16",
    "duration_secs": 20
  },
  "tags": [
    "dramatic"
  ]
}