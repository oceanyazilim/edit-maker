{
  "schema_version": 1,
  "id": "smooth-aesthetic",
  "name": "Smooth Aesthetic",
  "version": 1,
  "description": "Gentle beat-aligned cuts, soft dissolves, bright airy grade, no shake.",
  "pacing": {
    "base_shot_beats": 4.0,
    "section_multipliers": {
      "intro": 2.0,
      "groove": 1.0,
      "build_up": 1.0,
      "drop": 0.75,
      "breakdown": 2.0,
      "outro": 2.0
    },
    "min_shot_secs": 0.8,
    "max_shot_secs": 6.0,
    "build_up_acceleration": 0.3
  },
  "beat_sync": 0.75,
  "drop": {
    "impact": 0.4,
    "position": 0.4,
    "flash": false,
    "zoom_punch": 0.05,
    "rgb_split": false,
    "shake": false,
    "pre_drop_hold_beats": 1.0,
    "pre_drop_slowmo": 1.0,
    "velocity": 0,
    "glitch": 0,
    "zoom_blur": 0
  },
  "effects": {
    "intensity": 0.3,
    "kick_zoom": 0.02,
    "kick_shake": 0.0,
    "kick_threshold": 0.7,
    "cooldown_beats": 2.0,
    "max_per_bar": 1,
    "kick_sections": [
      "drop"
    ],
    "color": {
      "brightness": 0.04,
      "contrast": 0.95,
      "saturation": 1.05
    },
    "vignette": 0.0,
    "slow_zoom": 0.06,
    "kick_glitch": 0,
    "kick_blur": 0,
    "kick_chroma": 0
  },
  "transitions": {
    "frequency": 0.5,
    "kinds": [
      "cross_dissolve"
    ],
    "duration_beats": 1.0,
    "sections": [
      "intro",
      "groove",
      "breakdown",
      "outro",
      "drop"
    ]
  },
  "energy_bias": -0.2,
  "smart_crop": true,
  "fade_in_secs": 0.4,
  "fade_out_secs": 1.0,
  "output": {
    "platforms": [
      "tiktok",
      "reels",
      "shorts"
    ],
    "aspect": "9:16",
    "duration_secs": 20
  },
  "tags": [
    "aesthetic"
  ]
}