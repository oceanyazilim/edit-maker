    "kinds": [
      "cross_dissolve"
    ],
    "duration_beats": 0.75,
    "sections": [
      "intro",
      "breakdown",
      "outro"
    ]
  },
  "energy_bias": 0.0,
  "smart_crop": true,
  "fade_in_secs": 0.3,
  "fade_out_secs": 0.8,
  "output": {
    "platforms": [
      "tiktok",
      "reels",
      "shorts"
    ],
    "aspect": "9:16",
    "duration_secs": 20
  },
  "tags": [
    "character"
  ],
  "scoring": {
    "energy_match": 0.6,
    "quality": 1.0,
    "action_alignment": 0.5,
    "repetition_penalty": 1.4,
    "continuity": 1.0,
    "diversity": 0.5,
    "niche_tags": 0.5,
    "duration_fit": 0.5
  }
