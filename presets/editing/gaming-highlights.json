{
  "schema_version": 1,
  "id": "gaming-highlights",
  "name": "Gaming Highlights",
  "version": 1,
  "description": "Moments first: keeps action peaks intact, punches on big hits, few transitions.",
  "pacing": {
    "base_shot_beats": 4.0,
    "section_multipliers": {
      "intro": 1.5,
      "groove": 1.0,
      "build_up": 0.8,
      "drop": 0.6,
      "breakdown": 1.5,
      "outro": 1.5
    },
    "min_shot_secs": 0.5,
    "max_shot_secs": 5.0,
    "build_up_acceleration": 0.4
  },
  "beat_sync": 0.7,
  "drop": {
    "impact": 0.8,
    "position": 0.3,
    "flash": true,
    "zoom_punch": 0.1,
    "rgb_split": false,
    "shake": true,
    "pre_drop_hold_beats": 0.5,
    "pre_drop_slowmo": 1.0,
    "velocity": 0.5,
    "glitch": 0.3,
    "zoom_blur": 0.08
  },
  "effects": {
    "intensity": 0.6,
    "kick_zoom": 0.05,
    "kick_shake": 0.006,
    "kick_threshold": 0.55,
    "cooldown_beats": 1.0,
    "max_per_bar": 2,
    "kick_sections": [
      "drop",
      "groove"
    ],
    "color": {
      "brightness": 0.0,
      "contrast": 1.1,
      "saturation": 1.1
    },
    "vignette": 0.0,
    "slow_zoom": 0.0,
    "kick_glitch": 0.2,
    "kick_blur": 0.03,
    "kick_chroma": 0.0
  },
  "transitions": {
    "frequency": 0.1,
    "kinds": [
      "zoom_blend"
    ],
    "duration_beats": 0.5,
    "sections": [
      "intro",
      "breakdown",
      "outro"
    ]
  },
  "energy_bias": 0.4,
  "smart_crop": true,
  "fade_in_secs": 0.0,
  "fade_out_secs": 0.6,
  "output": {
    "platforms": [
      "tiktok",
      "reels",
      "shorts"
    ],
    "aspect": "9:16",
    "duration_secs": 20
  },
  "tags": [
    "gaming"
  ],
  "scoring": {
    "energy_match": 0.8,
    "quality": 0.4,
    "action_alignment": 1.4,
    "repetition_penalty": 1.4,
    "continuity": 0.8,
    "diversity": 0.5,
    "niche_tags": 0.5,
    "duration_fit": 0.5
  }
}