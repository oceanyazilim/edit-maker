      "build_up": 1.0,
      "drop": 0.75,
      "breakdown": 2.0,
      "outro": 2.0
    },
    "min_shot_secs": 0.8,
    "max_shot_secs": 6.0,
    "build_up_acceleration": 0.4
  },
  "beat_sync": 0.8,
  "drop": {
    "impact": 0.6,
    "position": 0.35,
    "flash": true,
    "zoom_punch": 0.08,
    "rgb_split": false,
    "shake": false,
    "pre_drop_hold_beats": 1.0,
    "pre_drop_slowmo": 0.7,
    "velocity": 0,
    "glitch": 0,
    "zoom_blur": 0
  },
  "effects": {
    "intensity": 0.4,
    "kick_zoom": 0.04,
    "kick_shake": 0.0,
    "kick_threshold": 0.6,
