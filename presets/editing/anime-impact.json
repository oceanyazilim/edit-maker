  "scoring": {
    "energy_match": 1.0,
    "quality": 0.4,
    "action_alignment": 1.2,
    "repetition_penalty": 1.6,
    "continuity": 0.6,
    "diversity": 0.5,
    "niche_tags": 0.5,
    "duration_fit": 0.3
  }
