{
  "schema_version": 1,
  "id": "commercial-product-promo",
  "name": "Commercial Product Promo",
  "version": 1,
  "description": "Clean, legible shots, moderate pacing, crisp grade, no aggressive effects.",
  "pacing": {
    "base_shot_beats": 4.0,
    "section_multipliers": {
      "intro": 1.5,
      "groove": 1.0,
      "build_up": 0.8,
      "drop": 0.6,
      "breakdown": 1.5,
      "outro": 2.0
    },
    "min_shot_secs": 0.8,
    "max_shot_secs": 5.0,
    "build_up_acceleration": 0.3
  },
  "beat_sync": 0.8,
  "drop": {
    "impact": 0.5,
    "position": 0.3,
    "flash": false,
    "zoom_punch": 0.06,
    "rgb_split": false,
    "shake": false,
    "pre_drop_hold_beats": 1.0,
    "pre_drop_slowmo": 1.0,
    "velocity": 0,
    "glitch": 0,
    "zoom_blur": 0
  },
  "effects": {
    "intensity": 0.3,
    "kick_zoom": 0.03,
    "kick_shake": 0.0,
    "kick_threshold": 0.7,
    "cooldown_beats": 2.0,
    "max_per_bar": 1,
    "kick_sections": [
      "drop"
    ],
    "color": {
      "brightness": 0.03,
      "contrast": 1.05,
      "saturation": 1.05
    },
    "vignette": 0.0,
    "slow_zoom": 0.05,
    "kick_glitch": 0,
    "kick_blur": 0,
    "kick_chroma": 0
  },
  "transitions": {
    "frequency": 0.25,
    "kinds": [
      "cross_dissolve",
      "zoom_blend"
    ],
    "duration_beats": 0.5,
    "sections": [
      "intro",
      "groove",
      "outro"
    ]
  },
  "energy_bias": 0.0,
  "smart_crop": true,
  "fade_in_secs": 0.3,
  "fade_out_secs": 0.8,
  "output": {
    "platforms": [
      "tiktok",
      "reels",
      "shorts"
    ],
    "aspect": "9:16",
    "duration_secs": 15
  },
  "tags": [
    "commercial"
  ],
  "scoring": {
    "energy_match": 0.5,
    "quality": 1.4,
    "action_alignment": 0.3,
    "repetition_penalty": 1.5,
    "continuity": 0.6,
    "diversity": 0.6,
    "niche_tags": 0.4,
    "duration_fit": 0.5
  }
}