      "brightness": 0.02,
      "contrast": 1.1,
      "saturation": 1.05
    },
    "vignette": 0.3,
    "slow_zoom": 0.06,
    "kick_glitch": 0,
    "kick_blur": 0,
    "kick_chroma": 0
  },
  "transitions": {
